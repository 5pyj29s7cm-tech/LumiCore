{
  "name": "lumi-os",
  "private": true,
  "version": "3.0.3",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx launcher.ts",
    "dev:direct": "tsx server.ts",
    "serve": "node dist-server/entry.cjs",
    "build": "npm run build:desktop-ui",
    "build:desktop-ui": "npm run check:command-center-css && vite build --mode desktop",
    "build:mobile": "vite build --mode mobile",
    "build:frontends": "vite build --mode all",
    "docs:capability-stats": "tsx scripts/write-capability-stats.ts",
    "extension:sign": "tsx scripts/sign-lumi-extension.ts",
    "build:server": "npm run docs:capability-stats && node scripts/build-server.mjs",
    "prepare:node": "node scripts/download-node-binary.mjs",
    "prepare:desktop": "node scripts/prepare-desktop-resources.mjs",
    "build:desktop": "npm run build && npm run check:compact-layout-build && npm run build:server && npm run prepare:node && npm run prepare:desktop",
    "start": "tsx launcher.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron",
    "lint": "npm run lint:i18n && npm run lint:hooks && npm run lint:hooks:critical && tsc --noEmit",
    "lint:hooks": "eslint \"src/**/*.{ts,tsx}\" --quiet",
    "lint:hooks:critical": "eslint src/components/AgentChatPage.tsx src/components/DesktopUI.tsx src/hooks/useVoiceCall.ts src/hooks/useVoiceprint.ts src/hooks/useWakeWord.ts --max-warnings 0",
    "lint:i18n": "node scripts/check-i18n-boundaries.mjs",
    "lint:i18n:baseline": "node scripts/check-i18n-boundaries.mjs --write-baseline",
    "test": "node scripts/run-vitest.mjs",
    "test:watch": "vitest",
    "test:inventory": "node scripts/check-vitest-count.mjs",
    "security:audit": "node scripts/check-production-audit.mjs",
    "variant:new": "node scripts/variant-manager.mjs new",
    "variant:sync": "node scripts/variant-manager.mjs sync",
    "variant:promote": "node scripts/variant-manager.mjs promote",
    "check:bundle-budget": "node scripts/check-desktop-bundle-budget.mjs",
    "check:compact-layout-build": "node scripts/check-compact-layout-build.mjs",
    "check:command-center-css": "node scripts/check-command-center-css.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-first-run.mjs",
    "smoke:installer:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows-installer.ps1",
    "check:sqlite": "node scripts/check-sqlite-integrity.mjs",
    "stress:lifecycle": "node scripts/runtime-reliability.mjs --mode lifecycle",
    "stress:lifecycle:source": "node scripts/runtime-reliability.mjs --runtime source --mode lifecycle",
    "soak:runtime": "node scripts/runtime-reliability.mjs --mode soak",
    "soak:runtime:source": "node scripts/runtime-reliability.mjs --runtime source --mode soak",
    "release:check": "npm run docs:capability-stats && node scripts/check-release-readiness.mjs",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "release:bundle": "node scripts/prepare-release-bundle.mjs",
    "release:verify": "npm run lint && npm run test -- --run && npm run build:desktop && npm run smoke:packaged",
    "tauri": "tauri",
    "tauri:dev": "node scripts/prepare-tauri-dev.mjs && tauri dev",
    "tauri:dev:automation": "node scripts/prepare-tauri-dev.mjs && tauri dev --config src-tauri/tauri.automation.conf.json",
    "tauri:dev:raw": "tauri dev",
    "tauri:build": "tauri build",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:open-android": "cap open android",
    "mobile:open-ios": "cap open ios",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File scripts/deploy-windows.ps1",
    "deploy:mac": "bash scripts/deploy-macos.sh",
    "deploy:linux": "bash scripts/deploy-linux.sh",
    "repair:knowledge-filenames": "node scripts/repair-knowledge-filenames.mjs --apply",
    "repair:knowledge-filenames:dry": "node scripts/repair-knowledge-filenames.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@base-ui/react": "^1.3.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@larksuiteoapi/node-sdk": "^1.70.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@picovoice/porcupine-web": "^4.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.105.4",
    "@tauri-apps/api": "^2.11.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "node-fetch-native": "^1.6.7",
    "nodemailer": "^9.0.3",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.61.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.20.0",
    "zod": "^3.25.0"
  },
  "overrides": {
    "axios": "$axios",
    "node-fetch": "npm:node-fetch-native",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@capacitor/cli": "^8.3.1",
    "@tauri-apps/cli": "^2.11.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/sqlite3": "^3.1.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "4.1.1",
    "jsdom": "^26.1.0",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
