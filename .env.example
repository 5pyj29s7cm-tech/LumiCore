# ============================================================
# LumiCore Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================================

# -------------------------------------------------
# LLM Providers (at least one required)
# -------------------------------------------------

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# DeepSeek (primary — deepseek-chat / deepseek-reasoner)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Qwen / DashScope (Alibaba Cloud — also used by CosyVoice TTS)
DASHSCOPE_API_KEY=
# QWEN_API_KEY=           # alias, falls back to DASHSCOPE_API_KEY
# QWEN_MODEL=qwen-plus

# Doubao / Ark (ByteDance Volcengine)
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-1-5-pro-32k

# Xiaomi (XiaoAi / MiLM)
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://api.xiaomi.com/v1
# XIAOMI_MODEL=xiaomi-chat

# Moonshot / Kimi
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k

# Zhipu / GLM
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-plus

# Lumi official API (ModelDepot; OpenAI-compatible)
# Create a key at https://zhuan.huaczy.com/console/api-keys and keep it server-side.
# Recharge at https://zhuan.huaczy.com/console/recharge.
# API help: https://zhuan.huaczy.com/console/help.
# The documented base URL is https://zhuan.huaczy.com/v1.
# RELAY_API_KEY=
# RELAY_BASE_URL=https://zhuan.huaczy.com/v1
# Optional OpenAI-compatible role overrides (relative to RELAY_BASE_URL, or absolute URLs)
# RELAY_REASONING_MODEL=aliyun/qwen-plus
# RELAY_VISION_MODEL=aliyun/qwen2.5-vl-72b
# RELAY_WORLD_MODEL=aliyun/qwen3-vl-flash
# RELAY_IMAGE_MODEL=aliyun/qwen-image
# RELAY_IMAGE_EDIT_MODEL=aliyun/qwen-image-edit-2509
# RELAY_VIDEO_MODEL=aliyun/Wan2.2-T2V-A14B
# RELAY_IMAGE_TO_VIDEO_MODEL=aliyun/Wan2.2-I2V-A14B
# RELAY_EMBEDDING_MODEL=aliyun/bge-m3
# RELAY_RERANK_MODEL=aliyun/bge-reranker-v2-m3
# RELAY_STT_MODEL=aliyun/qwen-audio-3.0-asr-flash-streaming
# RELAY_TTS_MODEL=aliyun/cosyvoice-v3-flash
# RELAY_TTS_VOICE=longxiaochun_v3
# RELAY_IMAGE_PATH=/images/generations
# Qwen Image Edit uses the same JSON endpoint as image generation.
# RELAY_IMAGE_EDIT_PATH=/images/generations
# RELAY_VIDEO_PATH=/videos/generations
# RELAY_VIDEO_STATUS_PATH=/videos/generations/{id}
# RELAY_VIDEO_CONTENT_PATH=/videos/generations/{id}/content
# The guide documents rerank on the rooted business path below.
# RELAY_RERANK_PATH=/api/v1/rerank
# RELAY_EMBEDDINGS_PATH=/embeddings
# Official STT is a DashScope-compatible binary WebSocket stream. It uses
# run-task -> task-started -> binary PCM -> finish-task; there is no REST
# /audio/transcriptions route on the current official gateway.
# RELAY_TTS_PATH=/audio/speech
# RELAY_STT_STREAM_PATH=/audio/transcriptions/stream
# RELAY_STT_SILENCE_MS=850
# RELAY_ENABLE_STREAMING=0  # chat SSE opt-in only; unrelated to the voice WebSocket route

# -------------------------------------------------
# Local LLM (auto-detected, no key needed)
# -------------------------------------------------

# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234

# -------------------------------------------------
# Voice & Audio
# -------------------------------------------------

# Doubao Speech (TTS + STT). New-console API Key value only.
# DOUBAO_SPEECH_KEY=
# DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
# DOUBAO_FILE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# DOUBAO_TTS_VOICE_ID=zh_female_vv_uranus_bigtts

# Installed/local users clone through Qwen data-uri enrollment by default, no public URL needed.
# For server deployments that prefer public sample URLs, set COSYVOICE_CLONE_AUDIO_MODE=url
# and provide LUMI_PUBLIC_BASE_URL=https://your-public-domain.example
# COSYVOICE_MODEL=cosyvoice-v3-flash
# COSYVOICE_TARGET_MODEL=cosyvoice-v3-flash
# QWEN_VOICE_CLONE_TARGET_MODEL=qwen3-tts-vc-2026-01-22
# QWEN_VOICE_DESIGN_TARGET_MODEL=qwen3-tts-vd-realtime-2026-01-22
COSYVOICE_CLONE_AUDIO_MODE=data-url

# Local TTS storage. Keep large model/cache folders off C: on Windows.
# Keep these directories outside the source checkout, for example under <local-data-dir>/local-tts.
# LUMI_LOCAL_TTS_HOME=<local-data-dir>/local-tts
# HF_HOME=<local-data-dir>/local-tts/huggingface
# MODELSCOPE_CACHE=<local-data-dir>/local-tts/modelscope
# TORCH_HOME=<local-data-dir>/local-tts/torch

# Local CosyVoice (default local TTS; run the CosyVoice server separately)
# LOCAL_COSYVOICE_ENABLED=false
# LOCAL_COSYVOICE_API_URL=http://127.0.0.1:50000
# LOCAL_COSYVOICE_TTS_PATH=/inference_sft
# LOCAL_COSYVOICE_VOICE=中文女
# LOCAL_COSYVOICE_VOICES=中文女,中文男
# LOCAL_COSYVOICE_SAMPLE_RATE=22050

# GPT-SoVITS (local TTS — requires separate GPT-SoVITS server)
# GPTSOVITS_ENABLED=false
# GPTSOVITS_API_URL=

# -------------------------------------------------
# Auth & Security
# -------------------------------------------------

# JWT signing secret. Desktop/local installs generate and persist a random value
# when this is empty; set an explicit secret for managed organization servers.
# JWT_SECRET=

# -------------------------------------------------
# Server Config
# -------------------------------------------------

PORT=3000
NODE_ENV=development

# Bind address (default: 127.0.0.1). Set 0.0.0.0 explicitly for Docker/LAN servers.
# HOST=0.0.0.0

# Extra allowed browser origins for managed organization deployments (comma-separated).
# Localhost and the Tauri desktop origin are allowed automatically.
# CORS_ORIGINS=https://lumi.example.com

# Disabled by default: repeated operations become reusable workflows, but Lumi
# does not silently compile/install new executable skills without an explicit opt-in.
# LUMI_AUTO_GENERATE_EXECUTABLE_SKILLS=false

# -------------------------------------------------
# Release / Distribution
# -------------------------------------------------

LUMI_APP_VERSION=3.1.0
LUMI_RELEASE_CHANNEL=internal
LUMI_OFFICIAL_URL=https://lumiai.asia
LUMI_DOWNLOAD_URL=https://lumiai.asia/download
LUMI_SUPPORT_EMAIL=3565286431@qq.com

# Data directory (default: ~/LumiCore/)
# LUMI_DATA_DIR=

# Context token budget for conversations (default: 1,000,000)
# CONTEXT_TOKEN_BUDGET=1000000

# Comma-separated list of allowed shell commands for MCP tools
# LUMI_ALLOWED_COMMANDS=

# -------------------------------------------------
# Messaging Integrations (optional)
# -------------------------------------------------

# Feishu / Lark Bot
# FEISHU_TRANSPORT=long_connection
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# Required only when FEISHU_TRANSPORT=webhook
# FEISHU_VERIFICATION_TOKEN=

# WeCom (企业微信) AI Bot long connection (recommended for local deployment)
# WECOM_MODE=aibot_long_connection
# WECOM_BOT_ID=
# WECOM_BOT_SECRET=

# Legacy WeCom custom app webhook (requires a public HTTPS callback)
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_APP_SECRET=
# WECOM_TOKEN=
# WECOM_ENCODING_AES_KEY=

# WeChat Bot
# WECHAT_BOT_TOKEN=
# WECHAT_BOT_ID=
# WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# -------------------------------------------------
# Cloud & External Services (optional)
# -------------------------------------------------

# Supabase (cloud sync)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# GitHub (MCP marketplace)
# GITHUB_TOKEN=

# Alibaba Cloud AK (biometrics / real-name verification)
# ALIYUN_AK_ID=
# ALIYUN_AK_SECRET=

# QiChaCha (enterprise legal verification)
# QICHACHA_API_KEY=

# Email (SMTP for sending invitations etc.)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# SiliconFlow (nanobanana skill)
# SILICONFLOW_API_KEY=

# Netease Cloud Music
# NETEASE_APP_ID=
# NETEASE_PRIVATE_KEY=
