{
  "name": "lumi-skill-image",
  "version": "1.0.0",
  "description": "Process images: resize, convert format, and get metadata",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0",
    "sharp": "^0.33.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 1,
    "category": "Media",
    "icon": "Image",
    "capabilityDefault": {
      "operation": "create",
      "risk": "low",
      "sideEffects": [
        {
          "type": "local_read",
          "scope": "user-selected local image",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Resize and conversion return in-memory image data and do not overwrite the source file."
        ]
      },
      "trust": "official",
      "lane": "media"
    }
  }
}
