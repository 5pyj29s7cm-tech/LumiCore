{
  "name": "lumi-skill-weather",
  "version": "1.0.0",
  "description": "Real-time weather lookup for any city worldwide",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 1,
    "category": "Productivity",
    "icon": "CloudSun",
    "capabilityDefault": {
      "operation": "observe",
      "risk": "low",
      "sideEffects": [
        {
          "type": "network_read",
          "scope": "public weather endpoint",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Weather data is external and may be delayed."
        ]
      },
      "trust": "official",
      "lane": "web"
    }
  }
}
