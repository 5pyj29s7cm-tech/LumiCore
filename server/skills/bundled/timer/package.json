{
  "name": "lumi-skill-timer",
  "version": "1.0.0",
  "description": "Set timers, countdowns, and alarms with desktop notifications",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 2,
    "category": "Productivity",
    "icon": "Timer",
    "capabilityDefault": {
      "operation": "observe",
      "risk": "low",
      "sideEffects": [],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Timer state exists only inside the running Skill process."
        ]
      },
      "trust": "official",
      "lane": "system"
    },
    "toolCapabilities": {
      "set_timer": {
        "operation": "mutate",
        "risk": "medium",
        "sideEffects": [
          {
            "type": "local_state_change",
            "scope": "in-process timer registry",
            "reversible": true
          }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": [
            "non-empty MCP terminal receipt"
          ],
          "limitations": [
            "The timer is not durable across Skill process restarts."
          ]
        },
        "trust": "official",
        "lane": "system"
      },
      "cancel_timer": {
        "operation": "mutate",
        "risk": "medium",
        "sideEffects": [
          {
            "type": "local_state_change",
            "scope": "in-process timer registry",
            "reversible": false
          }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": [
            "non-empty MCP terminal receipt"
          ],
          "limitations": [
            "Cancellation removes the timer from the current Skill process."
          ]
        },
        "trust": "official",
        "lane": "system"
      }
    }
  }
}
