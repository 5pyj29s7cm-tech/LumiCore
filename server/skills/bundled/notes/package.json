{
  "name": "lumi-skill-notes",
  "version": "1.0.0",
  "description": "Quick notes: create, list, search, and delete notes stored locally",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 4,
    "category": "Productivity",
    "icon": "StickyNote",
    "capabilityDefault": {
      "operation": "observe",
      "risk": "low",
      "sideEffects": [
        {
          "type": "local_read",
          "scope": "local Lumi notes directory",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Read receipts expose only local note content and metadata."
        ]
      },
      "trust": "official",
      "lane": "files"
    },
    "toolCapabilities": {
      "create_note": {
        "operation": "create",
        "risk": "medium",
        "sideEffects": [
          {
            "type": "local_write",
            "scope": "local Lumi markdown note",
            "reversible": true
          }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": [
            "non-empty MCP terminal receipt"
          ],
          "limitations": [
            "A terminal receipt confirms the note handler returned; task verification may inspect the saved path."
          ]
        },
        "trust": "official",
        "lane": "files"
      },
      "delete_note": {
        "operation": "mutate",
        "risk": "medium",
        "sideEffects": [
          {
            "type": "local_write",
            "scope": "delete one local Lumi markdown note",
            "reversible": false
          }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": [
            "non-empty MCP terminal receipt"
          ],
          "limitations": [
            "Deletion is irreversible unless the note exists in a separate backup."
          ]
        },
        "trust": "official",
        "lane": "files"
      }
    }
  }
}
