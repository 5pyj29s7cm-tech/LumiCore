{
  "name": "lumi-skill-qrcode",
  "version": "1.0.0",
  "description": "Generate QR code PNG images from text or URLs",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 1,
    "category": "Productivity",
    "icon": "QrCode",
    "capabilityDefault": {
      "operation": "create",
      "risk": "low",
      "sideEffects": [
        {
          "type": "network_read",
          "scope": "public QR-code rendering endpoint",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "The returned QR image is in-memory data and is not saved automatically."
        ]
      },
      "trust": "official",
      "lane": "media"
    }
  }
}
