{
  "name": "lumi-skill-translator",
  "version": "1.0.0",
  "description": "Translate text between 50+ languages using libreTranslate",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 1,
    "category": "Language",
    "icon": "Languages",
    "capabilityDefault": {
      "operation": "observe",
      "risk": "low",
      "sideEffects": [
        {
          "type": "network_read",
          "scope": "external translation endpoint",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Translation quality and provider availability are external."
        ]
      },
      "trust": "official",
      "lane": "web"
    }
  }
}
