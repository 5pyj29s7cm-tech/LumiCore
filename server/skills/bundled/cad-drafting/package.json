{
  "name": "lumi-skill-cad-drafting",
  "version": "1.6.1",
  "description": "Source-verified CAD tracing with staged geometry extraction, receipt-based handoff, resumable visible AutoCAD MCP playback, and exact entity-count verification.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.22.0"
  },
  "lumi": {
    "displayName": "CAD Drafting Pack",
    "category": "Architecture",
    "icon": "Monitor",
    "toolCount": 4,
    "autoGenerated": false,
    "requiresSetup": false,
    "setupNote": "Image geometry must pass staged extraction and source comparison before the server issues an executable receipt. Visible AutoCAD playback verifies operation identity and entity deltas, resumes interrupted runs in the same document, and has no generated-file, LISP, SCRIPT, batch-command, or cursor fallback. Production drawings still require professional verification.",
    "capabilityDefault": {
      "operation": "create",
      "risk": "low",
      "sideEffects": [],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Planning receipts do not prove that AutoCAD or a drawing changed."
        ]
      },
      "trust": "official",
      "lane": "cad"
    },
    "toolCapabilities": {
      "autocad_playback_file": {
        "operation": "mutate",
        "risk": "high",
        "sideEffects": [
          {
            "type": "local_read",
            "scope": "verified CAD operations and geometry receipts",
            "reversible": true
          },
          {
            "type": "local_write",
            "scope": "AutoCAD progress, completion marker, and optional DWG output",
            "reversible": true
          },
          {
            "type": "desktop_control",
            "scope": "visible AutoCAD document and entities",
            "reversible": false
          },
          {
            "type": "process_execution",
            "scope": "audited PowerShell AutoCAD COM bridge",
            "reversible": false
          }
        ],
        "verification": {
          "strategy": "state_diff",
          "required": true,
          "requiredFields": [
            "status",
            "completionMarkerExists",
            "completionMarkerPath",
            "operationsPath"
          ],
          "successSignals": [
            "verified completion marker",
            "entity-count state diff"
          ],
          "limitations": [
            "Completion requires the exact operation-set marker and verified entity state."
          ],
          "requiredValues": {
            "status": "completed",
            "completionMarkerExists": true
          },
          "successStatuses": [
            "completed"
          ],
          "requiredArtifacts": [
            "completionMarkerPath"
          ]
        },
        "trust": "official",
        "lane": "cad",
        "prerequisites": [
          "Windows AutoCAD COM automation"
        ]
      },
      "autocad_new_document": {
        "operation": "mutate",
        "risk": "high",
        "sideEffects": [
          {
            "type": "desktop_control",
            "scope": "visible AutoCAD document",
            "reversible": false
          },
          {
            "type": "process_execution",
            "scope": "audited PowerShell AutoCAD COM bridge",
            "reversible": false
          }
        ],
        "verification": {
          "strategy": "state_diff",
          "required": true,
          "requiredFields": [
            "status",
            "documentCreated",
            "visible",
            "document"
          ],
          "successSignals": [
            "verified visible AutoCAD document"
          ],
          "limitations": [
            "The receipt proves only that a visible blank drawing was created."
          ],
          "requiredValues": {
            "status": "completed",
            "documentCreated": true,
            "visible": true
          },
          "successStatuses": [
            "completed"
          ]
        },
        "trust": "official",
        "lane": "cad",
        "prerequisites": [
          "Windows AutoCAD COM automation"
        ]
      },
      "cad_renovation_folder_workflow": {
        "operation": "create",
        "risk": "medium",
        "sideEffects": [
          {
            "type": "local_read",
            "scope": "user-selected renovation source folder",
            "reversible": true
          },
          {
            "type": "local_write",
            "scope": "source inventory and CAD execution-plan drafts when writeFiles is enabled",
            "reversible": true
          }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [
            "draftFiles",
            "workflowState"
          ],
          "successSignals": [
            "non-empty MCP terminal receipt"
          ],
          "limitations": [
            "Source inventory and draft plans are preparation, not CAD completion."
          ]
        },
        "trust": "official",
        "lane": "cad"
      }
    }
  }
}
