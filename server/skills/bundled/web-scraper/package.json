{
  "name": "lumi-skill-web-scraper",
  "version": "1.0.0",
  "description": "Smart web scraping with CSS selector support — extract structured data from websites",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0",
    "cheerio": "^1.0.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 1,
    "category": "Web",
    "icon": "Globe",
    "capabilityDefault": {
      "operation": "observe",
      "risk": "low",
      "sideEffects": [
        {
          "type": "network_read",
          "scope": "user-requested public webpage",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "The receipt proves fetched content, not the truth of page claims."
        ]
      },
      "trust": "official",
      "lane": "web"
    }
  }
}
