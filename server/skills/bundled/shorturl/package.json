{
  "name": "lumi-skill-shorturl",
  "version": "1.0.0",
  "description": "Shorten long URLs via is.gd free service",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 1,
    "category": "Web",
    "icon": "Link",
    "capabilityDefault": {
      "operation": "create",
      "risk": "medium",
      "sideEffects": [
        {
          "type": "external_state_change",
          "scope": "public short-link provider alias",
          "reversible": false
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "The external short-link provider controls retention and availability."
        ]
      },
      "trust": "official",
      "lane": "web"
    }
  }
}
