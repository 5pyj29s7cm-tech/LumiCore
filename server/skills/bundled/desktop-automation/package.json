{
  "name": "lumi-skill-desktop-automation",
  "version": "1.0.0",
  "description": "Full desktop automation — control mouse, keyboard, windows, OCR screen reading. LumiCore can see AND operate your desktop.",
  "type": "module",
  "lumi": {
    "displayName": "Desktop Commander",
    "category": "System",
    "icon": "Monitor",
    "toolCount": 8,
    "workflowIds": [
      "self_intro_demo"
    ],
    "autoGenerated": false,
    "requiresSetup": true,
    "setupNote": "Requires Python 3.10+ with MaaFramework. Run: pip install maa-mcp",
    "runCommand": "python",
    "runArgs": [
      "-m",
      "maa-mcp"
    ],
    "capabilityDefault": {
      "operation": "mutate",
      "risk": "high",
      "sideEffects": [
        {
          "type": "desktop_control",
          "scope": "visible mouse, keyboard, window, and browser state",
          "reversible": false
        },
        {
          "type": "process_execution",
          "scope": "configured desktop automation runtime",
          "reversible": false
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Every visible mutation requires post-action UI evidence."
        ]
      },
      "trust": "official",
      "lane": "desktop"
    }
  }
}
