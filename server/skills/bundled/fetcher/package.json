{
  "name": "lumi-skill-fetcher",
  "version": "1.0.0",
  "description": "Smart web content fetching — converts any URL to clean readable Markdown. Powered by fetcher-mcp with Playwright + Readability.",
  "type": "module",
  "dependencies": {
    "fetcher-mcp": "^1.0.0"
  },
  "lumi": {
    "displayName": "Web Fetcher Pro",
    "category": "Web",
    "icon": "Globe",
    "toolCount": 2,
    "autoGenerated": false,
    "runCommand": "npx",
    "runArgs": [
      "-y",
      "fetcher-mcp"
    ],
    "capabilityDefault": {
      "operation": "observe",
      "risk": "low",
      "sideEffects": [
        {
          "type": "network_read",
          "scope": "user-requested webpage",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Fetched content is external and may be incomplete or stale."
        ]
      },
      "trust": "official",
      "lane": "web"
    }
  }
}
