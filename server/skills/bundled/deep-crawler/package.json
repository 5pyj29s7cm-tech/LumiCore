{
  "name": "lumi-skill-deep-crawler",
  "version": "1.0.0",
  "description": "Advanced web crawler with authentication support, deep crawling (BFS/DFS), and LLM-powered content extraction. Powered by crawl4ai.",
  "type": "module",
  "dependencies": {
    "mcp-crawl4ai": "^1.0.0"
  },
  "lumi": {
    "displayName": "Deep Web Crawler",
    "category": "Web",
    "icon": "Search",
    "toolCount": 4,
    "autoGenerated": false,
    "runCommand": "npx",
    "runArgs": [
      "-y",
      "mcp-crawl4ai"
    ],
    "capabilityDefault": {
      "operation": "observe",
      "risk": "medium",
      "sideEffects": [
        {
          "type": "network_read",
          "scope": "user-requested crawl targets",
          "reversible": true
        },
        {
          "type": "credential_access",
          "scope": "explicit authenticated crawl context when supplied",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Authenticated crawling must remain within the user-authorized session and site policy."
        ]
      },
      "trust": "official",
      "lane": "web"
    }
  }
}
