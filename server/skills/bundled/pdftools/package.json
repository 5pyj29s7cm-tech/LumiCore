{
  "name": "lumi-skill-pdftools",
  "version": "1.0.0",
  "description": "PDF tools: merge multiple PDFs and extract document metadata",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0",
    "pdf-lib": "^1.17.0"
  },
  "lumi": {
    "autoGenerated": false,
    "toolCount": 1,
    "category": "Productivity",
    "icon": "FileText",
    "capabilityDefault": {
      "operation": "mutate",
      "risk": "medium",
      "sideEffects": [
        {
          "type": "local_read",
          "scope": "user-selected PDF files",
          "reversible": true
        },
        {
          "type": "local_write",
          "scope": "merged PDF output when merge is selected",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "The tool has read-only and write modes; static policy conservatively treats every call as state-changing."
        ]
      },
      "trust": "official",
      "lane": "office",
      "domains": [
        "pdf"
      ]
    }
  }
}
