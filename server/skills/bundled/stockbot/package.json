{
  "name": "lumi-skill-stockbot",
  "version": "1.1.2",
  "description": "Chinese A-stock market assistant — quotes, watchlists, intraday alerts, K-lines, indices, sectors, news, risk-managed trade planning, and paper trading. Data sourced from public market endpoints with fallback quote providers.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "lumi": {
    "displayName": "StockBot",
    "category": "Finance",
    "icon": "TrendingUp",
    "toolCount": 9,
    "autoGenerated": false,
    "requiresSetup": false,
    "setupNote": "Free data from public exchanges. No API key needed. Stock watching, trade planning, alerts, and paper trading are for learning and simulation only, not investment advice or real order placement.",
    "capabilityDefault": {
      "operation": "observe",
      "risk": "low",
      "sideEffects": [
        {
          "type": "network_read",
          "scope": "public market-data endpoints",
          "reversible": true
        }
      ],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Market data may be delayed or unavailable and is not investment advice."
        ]
      },
      "trust": "official",
      "lane": "industry",
      "domains": [
        "finance"
      ]
    },
    "toolCapabilities": {
      "paper_trade": {
        "operation": "mutate",
        "risk": "medium",
        "sideEffects": [
          {
            "type": "network_read",
            "scope": "public quote endpoints",
            "reversible": true
          },
          {
            "type": "local_write",
            "scope": "local simulated paper-trading portfolio",
            "reversible": true
          }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": [
            "non-empty MCP terminal receipt"
          ],
          "limitations": [
            "This changes only simulated local portfolio data and never places a real order."
          ]
        },
        "trust": "official",
        "lane": "industry",
        "domains": [
          "finance"
        ]
      },
      "paper_portfolio": {
        "operation": "mutate",
        "risk": "medium",
        "sideEffects": [
          {
            "type": "network_read",
            "scope": "public quote endpoints when refreshQuotes is enabled",
            "reversible": true
          },
          {
            "type": "local_write",
            "scope": "local simulated paper-trading portfolio when created or reset",
            "reversible": true
          }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": [
            "non-empty MCP terminal receipt"
          ],
          "limitations": [
            "Reset affects only simulated local portfolio data."
          ]
        },
        "trust": "official",
        "lane": "industry",
        "domains": [
          "finance"
        ]
      }
    }
  }
}
