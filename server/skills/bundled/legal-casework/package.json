{
  "name": "lumi-skill-legal-casework",
  "version": "1.1.0",
  "description": "Legal casework pack for intake, deadline planning, document outlines, local case-folder workflows, and lawyer-facing case analysis support.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "exceljs": "^4.4.0",
    "zod": "^3.22.0"
  },
  "lumi": {
    "displayName": "Legal Casework",
    "category": "Legal",
    "icon": "FileText",
    "toolCount": 4,
    "autoGenerated": false,
    "requiresSetup": false,
    "setupNote": "Designed for lawyer-assisted workflows. Lumi can organize local case folders and guide authorized legal-site research, but captcha/2FA/paywalls are completed by the user and final legal work must be reviewed by a qualified professional.",
    "capabilityDefault": {
      "operation": "create",
      "risk": "low",
      "sideEffects": [],
      "verification": {
        "strategy": "terminal_receipt",
        "required": true,
        "requiredFields": [],
        "successSignals": [
          "non-empty MCP terminal receipt"
        ],
        "limitations": [
          "Drafting and analysis receipts are not final legal advice."
        ]
      },
      "trust": "official",
      "lane": "industry",
      "domains": [
        "legal"
      ]
    },
    "toolCapabilities": {
      "legal_case_folder_workflow": {
        "operation": "create",
        "risk": "medium",
        "sideEffects": [
          {
            "type": "local_read",
            "scope": "user-selected legal case folder",
            "reversible": true
          },
          {
            "type": "local_write",
            "scope": "legal workflow draft files when writeFiles is enabled",
            "reversible": true
          }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [
            "draftFiles"
          ],
          "successSignals": [
            "non-empty MCP terminal receipt"
          ],
          "limitations": [
            "Folder inventory and generated drafts require lawyer review."
          ]
        },
        "trust": "official",
        "lane": "industry",
        "domains": [
          "legal"
        ]
      }
    }
  }
}
