{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": false,
      "source": "external",
      "transport": "stdio",
      "description": "Legacy external filesystem MCP. Desktop files use Lumi built-in native file tools without npx.",
      "capabilityDefault": {
        "operation": "mutate",
        "risk": "high",
        "sideEffects": [
          { "type": "local_read", "scope": "configured filesystem roots", "reversible": true },
          { "type": "local_write", "scope": "configured filesystem roots", "reversible": false }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": ["MCP terminal receipt"],
          "limitations": ["This legacy server mixes read and write tools; Lumi built-in file tools should be used instead."]
        },
        "trust": "third-party",
        "lane": "files"
      }
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "data/lumi.db"
      ],
      "enabled": false,
      "source": "external",
      "transport": "stdio",
      "description": "SQLite access for the local Lumi database.",
      "capabilityDefault": {
        "operation": "mutate",
        "risk": "high",
        "sideEffects": [
          { "type": "local_read", "scope": "configured SQLite database", "reversible": true },
          { "type": "local_write", "scope": "configured SQLite database", "reversible": false }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": ["MCP terminal receipt"],
          "limitations": ["The server exposes mixed query and mutation operations; database state requires task-level verification."]
        },
        "trust": "third-party",
        "lane": "memory"
      }
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "."
      ],
      "enabled": false,
      "source": "external",
      "transport": "stdio",
      "description": "Git repository inspection tools.",
      "capabilityDefault": {
        "operation": "mutate",
        "risk": "high",
        "sideEffects": [
          { "type": "local_read", "scope": "configured Git repository", "reversible": true },
          { "type": "local_write", "scope": "configured Git repository and working tree", "reversible": false },
          { "type": "process_execution", "scope": "Git command runtime", "reversible": false }
        ],
        "verification": {
          "strategy": "terminal_receipt",
          "required": true,
          "requiredFields": [],
          "successSignals": ["MCP terminal receipt"],
          "limitations": ["The server mixes inspection and repository mutation tools; commits and remote operations need separate task verification."]
        },
        "trust": "third-party",
        "lane": "files"
      }
    }
  },
  "remoteDevices": {}
}
