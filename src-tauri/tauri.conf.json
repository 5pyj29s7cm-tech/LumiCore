{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Lumi OS",
  "version": "3.0.2",
  "identifier": "com.lumiai.os",
  "build": {
    "frontendDist": "../dist/desktop",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop-ui && npm run build:server && npm run prepare:node && npm run prepare:desktop",
    "beforeBundleCommand": "node scripts/copy-webview2-dll.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Lumi OS",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "center": true,
        "alwaysOnTop": false,
        "alwaysOnBottom": false,
        "skipTaskbar": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3000 ws://127.0.0.1:3000 http://localhost:3000 ws://localhost:3000 https: wss:; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": [
      "../desktop-resources/dist-server/**/*",
      "../desktop-resources/gpt-sovits-src/**/*",
      "../desktop-resources/data/voice_training/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./includes/include-dll.nsh"
      }
    },
    "macOS": {
      "infoPlist": "./Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "pulseaudio-utils | pipewire-pulse",
          "brightnessctl",
          "xdotool",
          "xprintidle"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_PUBLIC_KEY",
      "endpoints": [
        "https://releases.lumiai.asia/lumi-os/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
